# Server
PORT=8080

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/flowcatalyst
DATABASE_USER=flowcatalyst
DATABASE_PASSWORD=flowcatalyst
DATABASE_POOL_SIZE=10

# Module flags
PLATFORM_ENABLED=true
MESSAGE_ROUTER_ENABLED=false
OUTBOX_PROCESSOR_ENABLED=false
DISPATCH_SCHEDULER_ENABLED=false
STREAM_PROCESSOR_ENABLED=false

# Auth
JWT_PRIVATE_KEY_PATH=jwt-private.pem
JWT_PUBLIC_KEY_PATH=jwt-public.pem

# Logging: "text" for dev, "json" for production structured output
LOG_FORMAT=text
