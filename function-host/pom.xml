<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.flowcatalyst</groupId>
    <artifactId>flowcatalyst-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>flowcatalyst-function-host</artifactId>
  <packaging>jar</packaging>

  <name>FlowCatalyst Function Host</name>
  <description>
    The JVM function host: the class-loading core that keeps functions apart
    (docs/spec/function-host-core.md §2), and, from D2 on, the reconciler,
    invoke path and FunctionContext services. Depends on the function API
    (the contract a function is written against) and the server module (for
    Digest, ArtifactStore, SignatureVerifier and Manifest, used from D2).
    Inherits the parent's Java 25 / --enable-preview compiler flags — unlike
    function-api, this module is not a contract a function author compiles
    against.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-function-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-server</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Wasm functions (docs/spec/function-wasm-runtime.md): the vendored Extism host SDK
         on Endive, plus Endive itself (the loader parses, validates and compiles modules
         directly) and the Extism HTTP interfaces our adapter implements. -->
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-extism-endive</artifactId>
    </dependency>
    <dependency>
      <groupId>run.endive</groupId>
      <artifactId>runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>run.endive</groupId>
      <artifactId>wasi</artifactId>
    </dependency>
    <dependency>
      <groupId>run.endive</groupId>
      <artifactId>compiler</artifactId>
    </dependency>
    <dependency>
      <groupId>org.extism.sdk</groupId>
      <artifactId>http-api</artifactId>
    </dependency>

    <!--
      D3 (docs/spec/function-host-listener.md §2): `io.flowcatalyst.fnhost.http`
      uses `vertx-core` directly (already resolvable transitively through
      `flowcatalyst-server` at compile scope — NOT declared as a direct
      dependency here). `vertx-codegen-api`/`vertx-codegen-json` are NOT
      vertx-core itself: they are the annotation classes (`@GenIgnore` etc.)
      vertx-core's own class files carry, needed on the compile classpath so
      `-Werror` does not fail on "cannot find annotation method" — the exact
      reason `server/pom.xml` already declares them, `provided` scope, nothing
      ships. Without them this module cannot compile any code that imports
      vertx-core under this repo's lint settings; flagged in the handback
      report as a POM-rule literal deviation, same pragmatic necessity server
      already accepted.
    -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-codegen-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-codegen-json</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Wasm database access (docs/spec/function-wasm-db.md) sets each statement's timeout
         in milliseconds through pgjdbc's PgStatement#setQueryTimeoutMs; that class carries
         checker-framework annotations, which javac must resolve under -Werror. Same
         reasoning as vertx-codegen above; pgjdbc already brings the jar at runtime. -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- WAT → wasm for the refusal fixtures, built at test time (spec §5) -->
      <groupId>run.endive</groupId>
      <artifactId>wabt</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      docs/spec/function-host-reconciler.md §1: the reconciler's tests need
      TestSigstore (signed fixture bundles + a TrustRoot), TestPg (an embedded
      Postgres) and TestHttp/the real Server (R12's in-process integration
      pin) from the server module's own test sources. Maven never carries
      test-scope dependencies transitively — even through a test-jar — so
      every test-scope dependency TestPg/Server themselves need (embedded
      Postgres + its platform binaries) is repeated here verbatim from
      server/pom.xml, the same duplication fcdev/pom.xml and parity/pom.xml
      already carry for the same reason (see fcdev/pom.xml's comment on
      embedded-postgres). CLAUDE.md build hygiene: never `mvn install` from a
      worktree — the reactor resolves this test-jar from server's own
      target/test-classes when built with `-pl function-host -am`.
    -->
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-server</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- native Apple-silicon PG binaries (the default bundle only ships amd64 for macOS) -->
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The test-jar (`docs/spec/function-developer-surface.md` §1, E1): fcdev's
        in-process acceptance test reuses `FixtureJars` (builds real fixture
        function jars at test time) rather than a second copy. Same shape as
        `server/pom.xml`'s own test-jar execution, copied rather than invented —
        nothing else in this module changes.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <phase>package</phase>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        The executable fc-fnhost jar (slice D5, `docs/spec/function-host-process.md`
        §1) — same shape as `server/pom.xml`'s own `fc-server` execution
        (service-file merging, signature-file exclusion), copied rather than
        invented: Main-Class and the artifact naming are the only differences.

          mvn -q -DskipTests -pl function-host -am package
          java -jar function-host/target/flowcatalyst-function-host-0.0.1-SNAPSHOT-exec.jar (with preview enabled)
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>fc-fnhost</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>exec</shadedClassifierName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.flowcatalyst.fnhost.FnHostMain</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                    <Implementation-Title>fc-fnhost</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
