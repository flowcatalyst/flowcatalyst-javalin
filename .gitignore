# Build
target/
*.class
*.jar
*.war

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath
*.swp

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Dev JWT keys / embedded Postgres data (fcdev)
.jwt-keys/
.fcdev/

# Logs
*.log

# Claude Code local settings
.claude/settings.local.json

# maven-shade-plugin writes this beside the pom, not into target/
server/dependency-reduced-pom.xml

# Frontend e2e (docs/spec/frontend-e2e.md)
e2e/node_modules
e2e/test-results
e2e/playwright-report

# Frontend (source lives here since 2026-09-14)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/components.d.ts
frontend/vite.config.d.ts

# Client SDKs (source lives here since 2026-09-14 — docs/sdk-release-plan.md,
# docs/go-mirror/2026-09-14-sdk-copies.md). Each folder also carries its own
# .gitignore (clients/laravel-sdk's covers vendor/ + composer.lock already);
# these are belt-and-braces so a build in either folder never shows as dirty.
clients/*/node_modules/
clients/*/dist/
clients/*/vendor/
