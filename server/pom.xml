<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.flowcatalyst</groupId>
    <artifactId>flowcatalyst-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>flowcatalyst-server</artifactId>
  <packaging>jar</packaging>

  <name>FlowCatalyst Server</name>
  <description>fc-server: platform API, router, stream processor, scheduler, outbox processor, MCP — subsystems toggled by FC_*_ENABLED.</description>

  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-usecase</artifactId>
    </dependency>

    <!-- Test-only: the agreement test (docs/spec/function-caller-claims.md §2) pins
         function-api's Caller.Principal authorisation copy equal to this module's own
         Permission/AuthContext rules — server never depends on function-api at runtime,
         only its test sources see both. -->
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-function-api</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- HTTP: Vert.x is the API/metrics listener (docs/spec/vertx-listener.md) —
         core + web, ever; HTTP/2 (h2c on the plain API listener, h2 over TLS with
         ALPN via Vert.x's own ALPN support) needs nothing beyond these two.
         HTTP/3 was Jetty/quiche-only and is dropped (docs/vertx-plan.md Q6,
         closed 2026-09-08). -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-codegen-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-codegen-json</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- JSON -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- No jackson-datatype-jdk8: JDK8 type support (Optional etc.) is
         merged into jackson-databind 3.x core (Java 17+ baseline). -->
    <dependency>
      <!-- /api/openapi.yaml: the JSON lockfile rendered as YAML, as Go does -->
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <!-- Database -->
    <dependency>
      <groupId>org.jooq</groupId>
      <artifactId>jooq</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <!-- compile-only: jOOQ's generated classes reference JAXB annotations; without the API on the
           compile classpath javac warns "unknown enum constant jakarta.xml.bind.annotation.XmlAccessType.FIELD" -->
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>

    <!-- Auth / crypto -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>
    <dependency>
      <groupId>com.password4j</groupId>
      <artifactId>password4j</artifactId>
    </dependency>
    <dependency>
      <!-- TOTP enrolment QR (auth-identity §6.5); pure Java, no AWT -->
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <!-- Passkeys (auth-identity §7): registration and assertion ceremonies -->
      <groupId>com.yubico</groupId>
      <artifactId>webauthn-server-core</artifactId>
    </dependency>
    <dependency>
      <!-- The WebAuthn library serialises its options with Jackson 2 (com.fasterxml), which
           lives beside the platform's Jackson 3 (tools.jackson) without overlap; it declares
           databind at runtime scope only, so the annotation types must be here for javac. -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Infra -->
    <!-- Router queue backends. Versions are pinned by the parent's
         dependencyManagement (awssdk BOM / jnats). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <exclusions>
        <!-- Only the sync clients are used (apache5-client); the async Netty client and
             its 3 MB of Netty were dead weight in both the jar and the native image. -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- Function artifact platform store (docs/spec/function-artifact-upload.md
           §2): FC_FN_ARTIFACT_STORE=s3://... -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <!-- Only the sync clients are used (apache5-client); the async Netty client and
             its 3 MB of Netty were dead weight in both the jar and the native image. -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>elasticloadbalancingv2</artifactId>
      <exclusions>
        <!-- Only the sync clients are used (apache5-client); the async Netty client and
             its 3 MB of Netty were dead weight in both the jar and the native image. -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
      <exclusions>
        <!-- Only the sync clients are used (apache5-client); the async Netty client and
             its 3 MB of Netty were dead weight in both the jar and the native image. -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.nats</groupId>
      <artifactId>jnats</artifactId>
    </dependency>

    <!-- Leader election for standby mode. Version pinned by the parent. -->
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
    </dependency>

    <dependency>
      <groupId>io.prometheus</groupId>
      <artifactId>prometheus-metrics-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.prometheus</groupId>
      <artifactId>prometheus-metrics-exposition-formats</artifactId>
    </dependency>
    <dependency>
      <groupId>io.prometheus</groupId>
      <artifactId>prometheus-metrics-instrumentation-jvm</artifactId>
    </dependency>

    <!-- MCP server: `mcp` pulls in mcp-core (McpStreamableServerTransportProvider,
         McpStreamableServerSession, the SDK's protocol machinery — see
         io.flowcatalyst.mcp.VertxStreamableServerTransportProvider, our own
         implementation over vertx-web, never the SDK's servlet transport) and
         mcp-json-jackson3 (JacksonMcpJsonMapper, wired to the platform's own
         Jackson 3 mapper, platform/shared/json/Json#MAPPER). jakarta.servlet-api
         is `provided` scope in mcp-core's own POM, so it is never pulled in
         transitively and never appears on this module's classpath. -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- native Apple-silicon PG binaries (the default bundle only ships amd64 for macOS) -->
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The test-jar (function-host-reconciler.md §1): function-host's tests need
        TestSigstore, TestPg and TestHttp (server test classes) to build fixture
        signatures, an embedded Postgres, and drive real HTTP against an
        in-process platform. function-host depends on this artifact with
        <type>test-jar</type>, test scope. Nothing else in this module changes —
        the production fc-server jar (maven-shade-plugin, above) is untouched.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <phase>package</phase>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        The executable fc-server jar — the production artefact, mirroring Go's
        single static `fc-server` binary. Attached with the `exec` classifier so
        the thin jar stays the module's main artifact (fcdev shades that one):

          mvn -q -DskipTests -pl server -am package
          java (with preview enabled) -jar server/target/flowcatalyst-server-0.0.1-SNAPSHOT-exec.jar

        The platform API is on by default; every other subsystem is off until
        its FC_*_ENABLED is set (io.flowcatalyst.server.Env). Implementation-Version is what /health
        reports (io.flowcatalyst.server.Version).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>fc-server</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>exec</shadedClassifierName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.flowcatalyst.server.Main</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                    <Implementation-Title>fc-server</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      GraalVM native image — an experiment (2026-09-04) to see whether fc-server
      can be a real static binary like the Go one. Needs a GraalVM JDK:

        mise install java@oracle-graalvm-25.0.4.1
        JAVA_HOME=$(mise where java@oracle-graalvm-25.0.4.1) mvn -q -DskipTests -pl server -am -Pnative package
        server/target/fc-server

      Reachability metadata for the third-party libraries comes from the
      GraalVM metadata repository; anything it does not cover surfaces as a
      runtime "not registered for reflection" error, not at build time.
    -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <!-- Reflection config for our own classes: records, enums, Jackson-annotated
               DTOs and jOOQ record types only (io.flowcatalyst.tools.NativeReflectConfig). -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>native-reflect-config</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>io.flowcatalyst.tools.NativeReflectConfig</mainClass>
                  <classpathScope>test</classpathScope>
                  <arguments>
                    <argument>${project.build.directory}/native-reflect-config.json</argument>
                    <argument>${project.build.outputDirectory}</argument>
                    <argument>${project.basedir}/../usecase/target/classes</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>1.1.12</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>fc-server</imageName>
              <mainClass>io.flowcatalyst.server.Main</mainClass>
              <metadataRepository>
                <enabled>true</enabled>
              </metadataRepository>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <!-- Without this java.net.URL cannot parse an http(s) URL in the
                     image: yubico's RelyingParty does `new URL(origin)` and falls
                     back to exact string matching for WebAuthn origins. Outbound
                     HTTP is java.net.http.HttpClient and unaffected. -->
                <buildArg>--enable-url-protocols=http,https</buildArg>
                <buildArg>--enable-preview</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <!-- Exactly our runtime resources. An earlier `io/.*` here also swept every
                     .class under io/netty, io/prometheus, io/nats and io/flowcatalyst into the
                     image heap as bytes: 24 MB of bytecode the binary already contained as code. -->
                <buildArg>-H:IncludeResources=db/.*|frontend/.*|openapi/.*|docs/.*|router/.*|schemas/.*|function/.*|io/flowcatalyst/platform/principal/common_passwords\.txt</buildArg>
                <!-- -O2, not -Os: the same code at -Os ran at 14% of Go and at -O2 at 32%
                     (bench/real/RESULTS.md rounds 9–10) for 6% more bytes; owner ruling 2026-09-07. -->
                <buildArg>-O2</buildArg>
                <buildArg>-H:ReflectionConfigurationFiles=${project.build.directory}/native-reflect-config.json</buildArg>
                <!-- Third-party reachability captured with the tracing agent (see native-config/README). -->
                <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/native-config</buildArg>
                <!-- No jar manifest in a native image; Version reads this property instead. -->
                <buildArg>-Dfc.version=${project.version}</buildArg>
                <buildArg>--initialize-at-build-time=io.flowcatalyst.server.Version</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      jOOQ code generation (docs/database.md). Starts an embedded PostgreSQL,
      runs the Flyway migrations, and regenerates io.flowcatalyst.db.generated
      (tables + records, committed) into src/main/java:

        mvn -pl server -Pjooq-codegen process-test-classes

      Override the output directory with -Djooq.target=<dir> (tools/jooq-verify.sh
      uses that to diff a fresh generation against the committed code).
      jooq-codegen is a plugin dependency only; it is not a project dependency.
    -->
    <profile>
      <id>jooq-codegen</id>
      <properties>
        <jooq.target>${project.basedir}/src/main/java</jooq.target>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen</artifactId>
                <version>${jooq.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>jooq-codegen</id>
                <phase>process-test-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>io.flowcatalyst.tools.JooqCodegen</mainClass>
                  <classpathScope>test</classpathScope>
                  <includePluginDependencies>true</includePluginDependencies>
                  <systemProperties>
                    <systemProperty>
                      <key>jooq.target</key>
                      <value>${jooq.target}</value>
                    </systemProperty>
                  </systemProperties>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
