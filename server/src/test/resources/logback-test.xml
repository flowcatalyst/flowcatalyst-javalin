<?xml version="1.0" encoding="UTF-8"?>
<!-- Test logging: keep Jetty/Javalin/Hikari/Flyway quiet; our own code at INFO. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="io.flowcatalyst" level="INFO"/>
  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
