{
  "name": "service-accounts: create/read/update/roles/token-mint lifecycle, validation, tenant confinement",
  "why": "the service-account aggregate mints real bearer credentials and its role-assignment/token-mint pair is anchor-only by spec design (diverging deliberately from Go's anchor-gated rotation) — a wire diff on any of these is a credential-issuance bug",
  "covers": ["listServiceAccounts", "createServiceAccount", "getServiceAccount", "getServiceAccountByCode",
             "updateServiceAccount", "deactivateServiceAccount", "deleteServiceAccount",
             "listServiceAccountRoles", "assignServiceAccountRoles",
             "regenerateServiceAccountAuthToken_regenerate-auth-token", "regenerateServiceAccountAuthToken_regenerate-token",
             "regenerateServiceAccountSigningSecret_regenerate-secret", "regenerateServiceAccountSigningSecret_regenerate-signing-secret",
             "mintServiceAccountToken", "createClient", "createPrincipal"],
  "steps": [
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 } },

    { "id": "create",
      "request": { "method": "POST", "path": "/api/service-accounts",
                   "body": { "code": "parity-sa-${run}", "name": "Parity Service Account",
                             "description": "parity harness", "clientIds": ["${client.id}"] } },
      "expect": { "status": 201 },
      "capture": { "saId": "/serviceAccount/id", "linkedPrincipalId": "/principalId",
                   "webhookAuthToken": "/webhook/authToken", "webhookSigningSecret": "/webhook/signingSecret" } },

    { "id": "get-created",
      "request": { "method": "GET", "path": "/api/service-accounts/${saId}" } },

    { "id": "get-by-code",
      "request": { "method": "GET", "path": "/api/service-accounts/code/parity-sa-${run}" } },

    { "id": "list",
      "request": { "method": "GET", "path": "/api/service-accounts" },
      "unordered": ["/serviceAccounts"] },

    { "id": "update",
      "request": { "method": "PUT", "path": "/api/service-accounts/${saId}",
                   "body": { "name": "Parity Service Account Updated", "description": "updated" } },
      "expect": { "status": 204 } },

    { "id": "get-updated",
      "request": { "method": "GET", "path": "/api/service-accounts/${saId}" } },

    { "id": "assign-roles",
      "request": { "method": "PUT", "path": "/api/service-accounts/${saId}/roles",
                   "body": { "roles": ["platform:messaging-admin"] } },
      "expect": { "status": 200 } },

    { "id": "list-roles",
      "request": { "method": "GET", "path": "/api/service-accounts/${saId}/roles" } },

    { "id": "mint-token",
      "request": { "method": "POST", "path": "/api/service-accounts/${saId}/token" },
      "expect": { "status": 200 },
      "capture": { "linkedToken": "/accessToken" } },

    { "id": "linked-account-refused-anchor-route",
      "why": "docs/spec/service-account-reach.md (owner 2026-09-13): an account linked to one client is CLIENT-scoped, so its token is refused an anchor-only route with ANCHOR_REQUIRED. Go still mints every service account as ANCHOR and answers 200 — Java-first, allow-listed.",
      "request": { "method": "GET", "path": "/api/clients", "auth": "${linkedToken}", "headers": { "Cookie": "" } } },

    { "id": "regenerate-auth-token",
      "request": { "method": "POST", "path": "/api/service-accounts/${saId}/regenerate-auth-token" },
      "expect": { "status": 200 },
      "capture": { "regenAuthToken1": "/authToken" } },

    { "id": "regenerate-token-alias",
      "request": { "method": "POST", "path": "/api/service-accounts/${saId}/regenerate-token" },
      "expect": { "status": 200 },
      "capture": { "regenAuthToken2": "/authToken" } },

    { "id": "regenerate-signing-secret",
      "request": { "method": "POST", "path": "/api/service-accounts/${saId}/regenerate-secret" },
      "expect": { "status": 200 },
      "capture": { "regenSigningSecret1": "/signingSecret" } },

    { "id": "regenerate-signing-secret-alias",
      "request": { "method": "POST", "path": "/api/service-accounts/${saId}/regenerate-signing-secret" },
      "expect": { "status": 200 },
      "capture": { "regenSigningSecret2": "/signingSecret" } },

    { "id": "deactivate",
      "request": { "method": "POST", "path": "/api/service-accounts/${saId}/deactivate" },
      "expect": { "status": 204 } },

    { "id": "get-deactivated",
      "request": { "method": "GET", "path": "/api/service-accounts/${saId}" } },

    { "id": "delete",
      "request": { "method": "DELETE", "path": "/api/service-accounts/${saId}" },
      "expect": { "status": 204 } },

    { "id": "delete-again",
      "request": { "method": "DELETE", "path": "/api/service-accounts/${saId}" } },

    { "id": "get-deleted",
      "request": { "method": "GET", "path": "/api/service-accounts/${saId}" } },

    { "id": "get-unknown-code",
      "request": { "method": "GET", "path": "/api/service-accounts/code/parity-sa-doesnotexist-${run}" } },

    { "id": "create-missing-code",
      "request": { "method": "POST", "path": "/api/service-accounts", "body": { "name": "No Code" } } },

    { "id": "create-missing-name",
      "request": { "method": "POST", "path": "/api/service-accounts", "body": { "code": "parity-sa-noname-${run}" } } },

    { "id": "create-invalid-webhook-auth-type",
      "request": { "method": "POST", "path": "/api/service-accounts",
                   "body": { "code": "parity-sa-badauth-${run}", "name": "Bad Auth",
                             "webhookCredentials": { "authType": "BOGUS_TYPE" } } } },

    { "id": "create-for-duplicate",
      "request": { "method": "POST", "path": "/api/service-accounts",
                   "body": { "code": "parity-sa-dup-${run}", "name": "Dup One" } },
      "expect": { "status": 201 },
      "capture": { "dupSaId": "/serviceAccount/id", "dupPrincipalId": "/principalId",
                   "dupWebhookAuthToken": "/webhook/authToken", "dupWebhookSigningSecret": "/webhook/signingSecret" } },

    { "id": "create-duplicate-code",
      "request": { "method": "POST", "path": "/api/service-accounts",
                   "body": { "code": "parity-sa-dup-${run}", "name": "Dup Two" } } },

    { "id": "mint-token-unknown-id",
      "request": { "method": "POST", "path": "/api/service-accounts/sac_doesnotexist99/token" } },

    { "id": "confinement-second-client",
      "request": { "method": "POST", "path": "/api/clients",
                   "body": { "name": "Parity SA Second Client", "identifier": "parity-sa-b-${run}" } },
      "expect": { "status": 201 },
      "capture": { "clientBId": "/id" } },

    { "id": "confinement-second-principal",
      "request": { "method": "POST", "path": "/api/principals",
                   "body": { "email": "parity-sa-b-${run}@example.test", "name": "Parity SA B Admin",
                             "scope": "CLIENT", "clientId": "${clientBId}", "password": "Correct-Harness-Battery-2381" } },
      "expect": { "status": 201 },
      "capture": { "principalBId": "/id" } },

    { "id": "confinement-login",
      "why": "service accounts carry no seeded role granting platform:iam:service-account:*, so a bare CLIENT-scope caller with no roles is the confinement probe: every service-account route must refuse it, whether or not the account belongs to another tenant, because the aggregate has no per-client read filter at all (ServiceAccountApi#list is repo().findAll() unfiltered) — worth flagging in the report if Go disagrees",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "parity-sa-b-${run}@example.test", "password": "Correct-Harness-Battery-2381" } },
      "expect": { "status": 200 } },

    { "id": "confinement-list-refused",
      "request": { "method": "GET", "path": "/api/service-accounts" } },

    { "id": "confinement-assign-roles-refused",
      "why": "role assignment and token mint are anchor-only regardless of client — Checks.requireAnchor, not a permission check",
      "request": { "method": "PUT", "path": "/api/service-accounts/${saId}/roles", "body": { "roles": [] } } }
  ]
}
