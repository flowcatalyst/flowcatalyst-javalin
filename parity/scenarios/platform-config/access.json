{
  "name": "platform-config: the property list and the anchor-only access-grant surface",
  "why": "the access-grant table is what a role check in every property route reads; a wire diff in the upsert-by-(app,role) rule (spec §1.2) or in the anchor-only gate on the grant routes would let a non-anchor escalate their own read/write access to another application's config",
  "covers": ["listPlatformConfigProperties", "listPlatformConfigAccess", "grantPlatformConfigAccess",
             "revokePlatformConfigAccess", "setPlatformConfigProperty", "createClient", "createPrincipal",
             "createRole", "assignPrincipalRoles"],
  "steps": [
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 },
      "capture": { "sess": "cookie:fc_session" } },

    { "id": "seed-a-property",
      "request": { "method": "PUT", "path": "/api/config/parity-pc-${run}/section-a/prop",
                   "body": { "value": "v1" } },
      "capture": { "propAId": "/id" } },

    { "id": "seed-another-property",
      "request": { "method": "PUT", "path": "/api/config/parity-pc-${run}/section-b/prop",
                   "body": { "value": "v2" } },
      "capture": { "propBId": "/id" } },

    { "id": "list-properties",
      "request": { "method": "GET", "path": "/api/platform-config/parity-pc-${run}" },
      "unordered": ["/items"] },

    { "id": "list-access-empty",
      "request": { "method": "GET", "path": "/api/platform-config/parity-pc-${run}/access" },
      "unordered": ["/items"] },

    { "id": "grant-read-write",
      "request": { "method": "POST", "path": "/api/platform-config/parity-pc-${run}/access",
                   "body": { "roleCode": "platform:viewer", "canWrite": true } },
      "expect": { "status": 201 },
      "capture": { "accessId": "/id" } },

    { "id": "list-access-after-grant",
      "request": { "method": "GET", "path": "/api/platform-config/parity-pc-${run}/access" },
      "unordered": ["/items"] },

    { "id": "regrant-same-role-updates-in-place",
      "why": "(applicationCode, roleCode) is unique — a second grant for the same pair updates the row in place, including de-escalating canWrite true to false (spec §1.2)",
      "request": { "method": "POST", "path": "/api/platform-config/parity-pc-${run}/access",
                   "body": { "roleCode": "platform:viewer", "canWrite": false } },
      "expect": { "status": 201 } },

    { "id": "list-access-after-regrant",
      "request": { "method": "GET", "path": "/api/platform-config/parity-pc-${run}/access" },
      "unordered": ["/items"] },

    { "id": "grant-missing-role-code",
      "request": { "method": "POST", "path": "/api/platform-config/parity-pc-${run}/access", "body": {} } },

    { "id": "grant-unvalidated-role-code-is-accepted",
      "why": "roleCode is not checked against iam_roles — bootstrap-before-the-role-exists is intended (spec §1.2)",
      "request": { "method": "POST", "path": "/api/platform-config/parity-pc-${run}/access",
                   "body": { "roleCode": "parity:does-not-exist-${run}", "canWrite": false } },
      "expect": { "status": 201 } },

    { "id": "revoke",
      "request": { "method": "DELETE", "path": "/api/platform-config/access/${accessId}" } },

    { "id": "list-access-after-revoke",
      "request": { "method": "GET", "path": "/api/platform-config/parity-pc-${run}/access" },
      "unordered": ["/items"] },

    { "id": "revoke-unknown",
      "request": { "method": "DELETE", "path": "/api/platform-config/access/cfa_doesnotexist1" } },

    { "id": "revoke-again-is-not-found",
      "request": { "method": "DELETE", "path": "/api/platform-config/access/${accessId}" } },

    { "id": "confinement-create-client",
      "request": { "method": "POST", "path": "/api/clients",
                   "body": { "name": "Parity Platform-Config Confinement Client", "identifier": "parity-pcconf-${run}" } },
      "expect": { "status": 201 },
      "capture": { "confClientId": "/id" } },

    { "id": "confinement-create-role",
      "request": { "method": "POST", "path": "/api/roles",
                   "body": { "applicationCode": "parity", "roleName": "pc-conf-${run}", "displayName": "Config Confinement Role",
                             "clientManaged": false } },
      "expect": { "status": 201 } },

    { "id": "confinement-grant-read-only-so-the-principal-can-see-the-app",
      "request": { "method": "POST", "path": "/api/platform-config/parity-pc-${run}/access",
                   "body": { "roleCode": "parity:pc-conf-${run}", "canWrite": false } },
      "expect": { "status": 201 } },

    { "id": "confinement-create-principal",
      "request": { "method": "POST", "path": "/api/principals",
                   "body": { "email": "parity-pcconf-${run}@example.com", "name": "Parity Platform-Config Confinement User",
                             "scope": "CLIENT", "clientId": "${confClientId}",
                             "password": "Correct-Harness-Battery-2381" } },
      "expect": { "status": 201 },
      "capture": { "confPrincipalId": "/id" } },

    { "id": "confinement-assign-role",
      "request": { "method": "PUT", "path": "/api/principals/${confPrincipalId}/roles",
                   "body": { "roles": ["parity:pc-conf-${run}"] } },
      "expect": { "status": 200 } },

    { "id": "confinement-login",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "parity-pcconf-${run}@example.com", "password": "Correct-Harness-Battery-2381" } },
      "expect": { "status": 200 } },

    { "id": "confinement-list-properties-allowed",
      "why": "a read grant on this applicationCode is enough for the property list (spec §3), even though the caller is not anchor",
      "request": { "method": "GET", "path": "/api/platform-config/parity-pc-${run}" },
      "unordered": ["/items"] },

    { "id": "confinement-list-access-forbidden",
      "why": "the access-grant routes themselves are anchor-only regardless of any config grant (spec §4)",
      "request": { "method": "GET", "path": "/api/platform-config/parity-pc-${run}/access" } },

    { "id": "confinement-grant-forbidden",
      "request": { "method": "POST", "path": "/api/platform-config/parity-pc-${run}/access",
                   "body": { "roleCode": "platform:viewer", "canWrite": true } } },

    { "id": "confinement-revoke-forbidden",
      "request": { "method": "DELETE", "path": "/api/platform-config/access/${accessId}" } }
  ]
}
