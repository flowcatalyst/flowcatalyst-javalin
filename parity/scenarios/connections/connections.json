{
  "name": "connections: CRUD (create/pause/activate re-read the row), filters, idempotent transitions, 4xx, real persisted-clientId confinement",
  "why": "A connection's clientId is genuinely persisted and drives authorization and visibility exactly like subscriptions (docs/spec/connection.md §5) — but create/pause/activate answer the full re-read ConnectionResponse, not just an id or 204, which is its own wire-shape hazard (a Go/Java field-order or omitted-null divergence would only show up on these three routes).",
  "covers": ["listConnections", "createConnection", "getConnection", "updateConnection", "deleteConnection",
             "activateConnection", "pauseConnection", "createClient", "createPrincipal", "assignPrincipalRoles"],
  "steps": [
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 } },

    { "id": "create",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1ccon-${run}", "name": "Order Webhook", "description": "parity harness connection",
                             "serviceAccountId": "svc_${run}" } },
      "expect": { "status": 201 },
      "capture": { "conId": "/id" } },

    { "id": "get-created",
      "request": { "method": "GET", "path": "/api/connections/${conId}" } },

    { "id": "create-client-scoped",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1ccon-${run}-scoped", "name": "Scoped Webhook",
                             "serviceAccountId": "svc_${run}", "clientId": "${client.id}" } },
      "expect": { "status": 201 },
      "capture": { "conScopedId": "/id" } },

    { "id": "list-by-status",
      "request": { "method": "GET", "path": "/api/connections", "query": { "status": "ACTIVE" } },
      "unordered": ["/connections"] },

    { "id": "list-by-client-id",
      "request": { "method": "GET", "path": "/api/connections", "query": { "clientId": "${client.id}" } },
      "unordered": ["/connections"] },

    { "id": "update",
      "request": { "method": "PUT", "path": "/api/connections/${conId}",
                   "body": { "name": "Order Webhook v2", "description": "updated", "externalId": "ext-123" } } },

    { "id": "get-updated",
      "request": { "method": "GET", "path": "/api/connections/${conId}" } },

    { "id": "pause",
      "request": { "method": "POST", "path": "/api/connections/${conId}/pause" } },

    { "id": "activate",
      "request": { "method": "POST", "path": "/api/connections/${conId}/activate" } },

    { "id": "activate-again-is-idempotent",
      "request": { "method": "POST", "path": "/api/connections/${conId}/activate" } },

    { "id": "delete",
      "request": { "method": "DELETE", "path": "/api/connections/${conId}" } },

    { "id": "delete-again",
      "request": { "method": "DELETE", "path": "/api/connections/${conId}" } },

    { "id": "get-after-delete",
      "request": { "method": "GET", "path": "/api/connections/${conId}" } },

    { "id": "create-code-required",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "name": "X", "serviceAccountId": "svc_${run}" } } },

    { "id": "create-invalid-code-format",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "Bad Code", "name": "X", "serviceAccountId": "svc_${run}" } } },

    { "id": "create-name-required",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1ccon-${run}-noname", "serviceAccountId": "svc_${run}" } } },

    { "id": "create-service-account-required",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1ccon-${run}-nosvc", "name": "X" } } },

    { "id": "create-duplicate-first",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1ccon-${run}-dup", "name": "Dup", "serviceAccountId": "svc_${run}" } },
      "expect": { "status": 201 },
      "capture": { "dupConId": "/id" } },

    { "id": "create-duplicate-conflict",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1ccon-${run}-dup", "name": "Dup Again", "serviceAccountId": "svc_${run}" } } },

    { "id": "update-missing",
      "request": { "method": "PUT", "path": "/api/connections/con_doesnotexist${run}", "body": { "name": "X" } } },

    { "id": "pause-missing",
      "request": { "method": "POST", "path": "/api/connections/con_doesnotexist${run}/pause" } },

    { "id": "create-second-client",
      "request": { "method": "POST", "path": "/api/clients",
                   "body": { "name": "S1C Connections Second Client", "identifier": "s1c-con-b-${run}" } },
      "expect": { "status": 201 },
      "capture": { "clientBId": "/id" } },

    { "id": "create-second-principal",
      "request": { "method": "POST", "path": "/api/principals",
                   "body": { "email": "s1c-con-b-${run}@example.com", "name": "S1C Con B User",
                             "scope": "CLIENT", "clientId": "${clientBId}",
                             "password": "Correct-Harness-Battery-2381" } },
      "expect": { "status": 201 },
      "capture": { "principalBId": "/id" } },

    { "id": "assign-role",
      "request": { "method": "PUT", "path": "/api/principals/${principalBId}/roles",
                   "body": { "roles": ["platform:messaging-admin"] } },
      "expect": { "status": 200 } },

    { "id": "login-as-b",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "s1c-con-b-${run}@example.com", "password": "Correct-Harness-Battery-2381" } },
      "expect": { "status": 200 } },

    { "id": "b-cannot-read-anchors-scoped-connection",
      "request": { "method": "GET", "path": "/api/connections/${conScopedId}" } },

    { "id": "b-cannot-update-anchors-scoped-connection",
      "request": { "method": "PUT", "path": "/api/connections/${conScopedId}", "body": { "name": "Touched By B" } } },

    { "id": "b-cannot-pause-anchors-scoped-connection",
      "request": { "method": "POST", "path": "/api/connections/${conScopedId}/pause" } },

    { "id": "b-can-create-own",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1cconb-${run}-own", "name": "X", "serviceAccountId": "svc_${run}",
                             "clientId": "${clientBId}" } },
      "expect": { "status": 201 },
      "capture": { "ownConId": "/id" } },

    { "id": "b-cannot-create-platform-wide",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1cconb-${run}-platform", "name": "X", "serviceAccountId": "svc_${run}" } } },

    { "id": "b-cannot-create-scoped-to-foreign-client",
      "request": { "method": "POST", "path": "/api/connections",
                   "body": { "code": "s1cconb-${run}-foreign", "name": "X", "serviceAccountId": "svc_${run}",
                             "clientId": "${client.id}" } } }
  ]
}
