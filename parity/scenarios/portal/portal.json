{
  "name": "portal: OAuth client + invite, password-reset set-password, authorize/check-domain/login/password-reset, SSO refusal",
  "why": "PortalAuthApi and PortalSso are entirely public routes outside the lockfile (auth-identity.md §5.1-§5.6): a wire diff on the flow-id redirect, the check-domain SSO/PASSWORD branch, the authorization code embedded in the login response, or the always-silent password-reset would be invisible to the aggregate suites (which never call through the flow) but would break the portal SPA on cutover day.",
  "covers": ["createClient", "createOAuthClient", "ensurePortalUser", "createPortalApp", "updatePortalApp",
             "grantPortalUserApp", "revokePortalUserApp"],
  "steps": [
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 } },

    { "id": "create-client",
      "request": { "method": "POST", "path": "/api/clients",
                   "body": { "name": "Parity S3 Portal Client", "identifier": "parity-s3-portal-${run}" } },
      "expect": { "status": 201 },
      "capture": { "portalClientId": "/id" } },

    { "id": "ensure-portal-user-with-invite-link",
      "why": "auth-identity.md §5.7: returnInviteLink hands back a set-password link the portal itself never sees by mail; the token is the query parameter of that URL (§3 param: capture form).",
      "request": { "method": "POST", "path": "/api/portal-users",
                   "body": { "clientId": "${portalClientId}", "email": "parity-s3-portal-${run}@example.com",
                             "returnInviteLink": true } },
      "expect": { "status": 200 },
      "capture": { "identityId": "/identityId", "inviteUrl": "/inviteUrl", "inviteToken": "param:/inviteUrl?token" } },

    { "id": "validate-invite-token",
      "request": { "method": "GET", "path": "/auth/password-reset/validate", "query": { "token": "${inviteToken}" } } },

    { "id": "validate-unknown-token",
      "request": { "method": "GET", "path": "/auth/password-reset/validate", "query": { "token": "not-a-real-token" } } },

    { "id": "confirm-portal-password",
      "why": "PasswordResetApi#confirm branches on token.portalSubject() into confirmPortal (spec §8.5): no 2FA gate, its own {status,message,redirectUri?,portal:true} shape.",
      "request": { "method": "POST", "path": "/auth/password-reset/confirm",
                   "body": { "token": "${inviteToken}", "password": "Correct-Harness-Battery-7712" } },
      "expect": { "status": 200 } },

    { "id": "confirm-portal-password-token-already-burned",
      "request": { "method": "POST", "path": "/auth/password-reset/confirm",
                   "body": { "token": "${inviteToken}", "password": "Another-Correct-Battery-9931" } } },

    { "id": "create-portal-oauth-client",
      "why": "pkceRequired:false keeps the authorize/login round trip below out of PKCE (already pinned end to end for the employee plane in auth/oauth-code-flow.json).",
      "request": { "method": "POST", "path": "/api/oauth-clients",
                   "body": { "clientName": "Parity S3 Portal Entry ${run}", "clientType": "PUBLIC",
                             "redirectUris": ["https://portal-s3-${run}.example.com/callback"],
                             "pkceRequired": false, "portalClientId": "${portalClientId}" } },
      "expect": { "status": 201 },
      "capture": { "portalOAuthClientId": "/client/clientId" } },

    { "id": "authorize-not-a-portal-client",
      "why": "an oauth client not flagged portal-and-api-access is rejected before a flow is ever started (PortalAuthApi#authorize).",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "s3-${run}-x", "client_id": "does-not-exist-${run}",
                              "redirect_uri": "https://portal-s3-${run}.example.com/callback", "response_type": "code" } } },

    { "id": "authorize",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "s3-${run}", "client_id": "${portalOAuthClientId}",
                              "redirect_uri": "https://portal-s3-${run}.example.com/callback", "response_type": "code" } },
      "expect": { "status": 307 },
      "capture": { "flowId": "location-param:flow" } },

    { "id": "check-domain",
      "request": { "method": "POST", "path": "/portal/auth/check-domain",
                   "body": { "flowId": "${flowId}", "email": "parity-s3-portal-${run}@example.com" } } },

    { "id": "check-domain-unknown-flow",
      "request": { "method": "POST", "path": "/portal/auth/check-domain",
                   "body": { "flowId": "not-a-real-flow", "email": "parity-s3-portal-${run}@example.com" } } },

    { "id": "login-wrong-password",
      "why": "a wrong password never consumes the flow (PortalAuthApi#login only consumes on success) — ${flowId} is still live for the next step.",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${flowId}", "email": "parity-s3-portal-${run}@example.com",
                             "password": "definitely-wrong" } } },

    { "id": "login-right-password",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${flowId}", "email": "parity-s3-portal-${run}@example.com",
                             "password": "Correct-Harness-Battery-7712" } },
      "expect": { "status": 200 },
      "capture": { "portalAuthCode": "param:/redirectUrl?code" } },

    { "id": "login-flow-already-consumed",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${flowId}", "email": "parity-s3-portal-${run}@example.com",
                             "password": "Correct-Harness-Battery-7712" } } },

    { "id": "authorize-again-for-password-reset",
      "why": "a fresh flow: /portal/auth/password-reset does not consume it, but re-using the burned one above would only show FLOW_EXPIRED again.",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "s3-${run}-reset", "client_id": "${portalOAuthClientId}",
                              "redirect_uri": "https://portal-s3-${run}.example.com/callback", "response_type": "code" } },
      "expect": { "status": 307 },
      "capture": { "resetFlowId": "location-param:flow" } },

    { "id": "portal-password-reset-known-email",
      "why": "always a silent 200 (spec §5.4), whether or not the identity exists — no account enumeration.",
      "request": { "method": "POST", "path": "/portal/auth/password-reset",
                   "body": { "flowId": "${resetFlowId}", "email": "parity-s3-portal-${run}@example.com" } },
      "expect": { "status": 200 } },

    { "id": "portal-password-reset-unknown-email",
      "request": { "method": "POST", "path": "/portal/auth/password-reset",
                   "body": { "flowId": "${resetFlowId}", "email": "parity-s3-portal-nobody-${run}@example.com" } },
      "expect": { "status": 200 } },

    { "id": "portal-oidc-login-missing-params",
      "why": "no identity provider is configured for this domain in the seed — PortalSso#start's own gate, not the bridge's.",
      "request": { "method": "GET", "path": "/portal/auth/oidc/login" } },

    { "id": "portal-oidc-login-unknown-provider",
      "why": "flow+provider_id both present consumes the parked flow before the provider lookup fails (PortalSso#start) — 500 OIDC_RESOLVE_FAILED, not a 400.",
      "request": { "method": "GET", "path": "/portal/auth/oidc/login",
                   "query": { "flow": "${resetFlowId}", "provider_id": "idp_doesnotexist${run}" } } },

    { "id": "portal-oidc-login-flow-now-burned",
      "request": { "method": "GET", "path": "/portal/auth/oidc/login",
                   "query": { "flow": "${resetFlowId}", "provider_id": "idp_doesnotexist${run}" } } },

    { "id": "create-gate-app-a",
      "why": "portal-apps.md §9.5 gate sequence: two apps under the same portal client, a user granted only A.",
      "request": { "method": "POST", "path": "/api/portal-apps",
                   "body": { "clientId": "${portalClientId}", "code": "gate-a-${run}", "name": "Gate App A",
                             "redirectUris": ["https://gate-a-${run}.example.com/callback"], "clientType": "PUBLIC" } },
      "expect": { "status": 201 },
      "capture": { "gateAAppId": "/portalApp/id", "gateAClientId": "/oauthClientId" } },

    { "id": "create-gate-app-b",
      "request": { "method": "POST", "path": "/api/portal-apps",
                   "body": { "clientId": "${portalClientId}", "code": "gate-b-${run}", "name": "Gate App B",
                             "redirectUris": ["https://gate-b-${run}.example.com/callback"], "clientType": "PUBLIC" } },
      "expect": { "status": 201 },
      "capture": { "gateBAppId": "/portalApp/id", "gateBClientId": "/oauthClientId" } },

    { "id": "ensure-gate-user-granted-a-only",
      "request": { "method": "POST", "path": "/api/portal-users",
                   "body": { "clientId": "${portalClientId}", "email": "parity-portal-gate-${run}@example.com",
                             "portalAppCode": "gate-a-${run}", "returnInviteLink": true } },
      "expect": { "status": 200 },
      "capture": { "gateUserId": "/identityId", "gateInviteToken": "param:/inviteUrl?token" } },

    { "id": "set-gate-user-password",
      "request": { "method": "POST", "path": "/auth/password-reset/confirm",
                   "body": { "token": "${gateInviteToken}", "password": "Correct-Gate-Battery-4471" } },
      "expect": { "status": 200 } },

    { "id": "authorize-via-a",
      "why": "spec §3.4 step 3: every app-provisioned OAuth client has pkce_required true, unconditionally — the gate flows below all carry a PKCE challenge, unlike the legacy client-wide flow above.",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "gate-a-${run}", "scope": "openid profile email", "client_id": "${gateAClientId}",
                              "redirect_uri": "https://gate-a-${run}.example.com/callback", "response_type": "code",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "gateFlowA": "location-param:flow" } },

    { "id": "login-via-a-succeeds",
      "why": "spec §9.5: password login via the app the user IS granted ⇒ 200.",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowA}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "Correct-Gate-Battery-4471" } },
      "expect": { "status": 200 },
      "capture": { "gateCodeA": "param:/redirectUrl?code" } },

    { "id": "redeem-code-a",
      "why": "spec §9.6/§5.4: the id_token for an app-linked client carries portal_app_code/portal_app_id/portal_client_id — the JWS structural comparison (parity-harness.md §5 rule 4) pins their presence and value on both sides.",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "authorization_code", "code": "${gateCodeA}",
                             "redirect_uri": "https://gate-a-${run}.example.com/callback",
                             "client_id": "${gateAClientId}", "code_verifier": "${pkce.verifier}" } },
      "expect": { "status": 200 } },

    { "id": "authorize-via-b-first",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "gate-b1-${run}", "scope": "openid profile email", "client_id": "${gateBClientId}",
                              "redirect_uri": "https://gate-b-${run}.example.com/callback", "response_type": "code",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "gateFlowB1": "location-param:flow" } },

    { "id": "login-via-b-wrong-password",
      "why": "spec §9.5: wrong password via the ungranted app ⇒ 401 — never 403 first (the gate runs only after a successful password verify, spec §5.1 step 2/§10). The flow is not consumed on a wrong password either way, so ${gateFlowB1} is still live for the next two steps.",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowB1}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "definitely-wrong-gate" } } },

    { "id": "login-via-b-correct-password-no-grant",
      "why": "spec §9.5: right password, no grant ⇒ 403 NO_PORTAL_ACCESS, and the flow is still NOT consumed (spec §5.1 step 2: 'the flow is not consumed'), so the retry below after granting reuses ${gateFlowB1}.",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowB1}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "Correct-Gate-Battery-4471" } } },

    { "id": "grant-app-b",
      "request": { "method": "POST", "path": "/api/portal-users/${gateUserId}/apps",
                   "body": { "clientId": "${portalClientId}", "portalAppCode": "gate-b-${run}" } },
      "expect": { "status": 200 } },

    { "id": "login-via-b-after-grant-succeeds",
      "why": "spec §9.5: 'after GrantApp(B) → 200' — reusing ${gateFlowB1}, proving it truly survived the 403 above.",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowB1}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "Correct-Gate-Battery-4471" } },
      "expect": { "status": 200 } },

    { "id": "deactivate-app-a",
      "request": { "method": "PUT", "path": "/api/portal-apps/${gateAAppId}",
                   "body": { "clientId": "${portalClientId}", "active": false } },
      "expect": { "status": 200 } },

    { "id": "authorize-via-a-second",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "gate-a2-${run}", "scope": "openid profile email", "client_id": "${gateAClientId}",
                              "redirect_uri": "https://gate-a-${run}.example.com/callback", "response_type": "code",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "gateFlowA2": "location-param:flow" } },

    { "id": "login-via-a-after-deactivate",
      "why": "spec §9.5: 'A deactivated ⇒ 403' — still granted, but the app itself is inactive.",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowA2}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "Correct-Gate-Battery-4471" } } },

    { "id": "reactivate-app-a",
      "request": { "method": "PUT", "path": "/api/portal-apps/${gateAAppId}",
                   "body": { "clientId": "${portalClientId}", "active": true } },
      "expect": { "status": 200 } },

    { "id": "revoke-app-a",
      "request": { "method": "DELETE", "path": "/api/portal-users/${gateUserId}/apps/gate-a-${run}",
                   "query": { "clientId": "${portalClientId}" } },
      "expect": { "status": 200 } },

    { "id": "authorize-via-a-third",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "gate-a3-${run}", "scope": "openid profile email", "client_id": "${gateAClientId}",
                              "redirect_uri": "https://gate-a-${run}.example.com/callback", "response_type": "code",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "gateFlowA3": "location-param:flow" } },

    { "id": "login-via-a-after-revoke-fails",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowA3}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "Correct-Gate-Battery-4471" } } },

    { "id": "authorize-via-b-second",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "gate-b2-${run}", "scope": "openid profile email", "client_id": "${gateBClientId}",
                              "redirect_uri": "https://gate-b-${run}.example.com/callback", "response_type": "code",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "gateFlowB2": "location-param:flow" } },

    { "id": "login-via-b-after-revoke-a-still-works",
      "why": "spec §9.5: 'RevokeApp(A) keeps B' — B's own grant is untouched.",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowB2}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "Correct-Gate-Battery-4471" } },
      "expect": { "status": 200 },
      "capture": { "gateCodeB2": "param:/redirectUrl?code" } },

    { "id": "redeem-code-b2",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "authorization_code", "code": "${gateCodeB2}",
                             "redirect_uri": "https://gate-b-${run}.example.com/callback",
                             "client_id": "${gateBClientId}", "code_verifier": "${pkce.verifier}" } },
      "expect": { "status": 200 } },

    { "id": "authorize-via-b-third-for-redemption-race",
      "why": "spec §9.6: 'revoke the grant, then a fresh code → 400 invalid_grant' — a code issued while still granted, redeemed after the grant is gone: redemption re-checks the grant independently of login time (spec §5.3).",
      "request": { "method": "GET", "path": "/portal/authorize",
                   "query": { "state": "gate-b3-${run}", "scope": "openid profile email", "client_id": "${gateBClientId}",
                              "redirect_uri": "https://gate-b-${run}.example.com/callback", "response_type": "code",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "gateFlowB3": "location-param:flow" } },

    { "id": "login-via-b-for-redemption-race",
      "request": { "method": "POST", "path": "/portal/auth/login",
                   "body": { "flowId": "${gateFlowB3}", "email": "parity-portal-gate-${run}@example.com",
                             "password": "Correct-Gate-Battery-4471" } },
      "expect": { "status": 200 },
      "capture": { "gateCodeB3": "param:/redirectUrl?code" } },

    { "id": "revoke-app-b",
      "request": { "method": "DELETE", "path": "/api/portal-users/${gateUserId}/apps/gate-b-${run}",
                   "query": { "clientId": "${portalClientId}" } },
      "expect": { "status": 200 } },

    { "id": "redeem-code-b3-after-revoke",
      "why": "spec §5.3/§9.6: 400 invalid_grant — the code was valid when issued, but the grant is gone by redemption time.",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "authorization_code", "code": "${gateCodeB3}",
                             "redirect_uri": "https://gate-b-${run}.example.com/callback",
                             "client_id": "${gateBClientId}", "code_verifier": "${pkce.verifier}" } } }
  ]
}
