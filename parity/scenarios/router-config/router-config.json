{
  "name": "router-config: the dispatch router-config document is an authenticated API route (R3′)",
  "why": "docs/spec/router-config-auth.md: the router fetches its queues and pools from GET /api/dispatch/router-config with an OAuth client-credentials token whose SERVICE principal holds the built-in platform:router role. Pins the three answers a caller can get — 200 with the document for a principal holding platform:messaging:dispatch-pool:view, 403 for a service account that has only platform:application-service, 401 with no credential — and that the built-in role exists with exactly that one permission. Java-first: Go has not built §3, so every router-config step is allow-listed against Go's 404 until it mirrors from the spec.",
  "covers": ["createApplication", "provisionApplicationServiceAccount", "getServiceAccountByCode", "assignServiceAccountRoles", "getRoleByCode"],
  "steps": [
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 } },

    { "id": "router-role-exists",
      "request": { "method": "GET", "path": "/api/roles/by-code/platform:router" } },

    { "id": "create-router-application",
      "request": { "method": "POST", "path": "/api/applications",
                   "body": { "code": "parity-router-${run}", "name": "Parity Router ${run}", "type": "APPLICATION" } },
      "expect": { "status": 201 },
      "capture": { "routerAppId": "/id" } },
    { "id": "provision-router-service-account",
      "request": { "method": "POST", "path": "/api/applications/${routerAppId}/provision-service-account" },
      "expect": { "status": 201 },
      "capture": { "routerClientId": "/serviceAccount/oauthClient/clientId", "routerClientSecret": "/serviceAccount/oauthClient/clientSecret",
                   "routerPrincipalId": "/serviceAccount/principalId" } },
    { "id": "router-service-account",
      "request": { "method": "GET", "path": "/api/service-accounts/code/app:parity-router-${run}" },
      "expect": { "status": 200 },
      "capture": { "routerServiceAccountId": "/id" } },
    { "id": "assign-router-role",
      "request": { "method": "PUT", "path": "/api/service-accounts/${routerServiceAccountId}/roles",
                   "body": { "roles": ["platform:application-service", "platform:router"] } } },
    { "id": "router-token",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "client_credentials", "client_id": "${routerClientId}", "client_secret": "${routerClientSecret}" } },
      "expect": { "status": 200 },
      "capture": { "routerToken": "/access_token" } },

    { "id": "router-config-with-router-role",
      "request": { "method": "GET", "path": "/api/dispatch/router-config", "auth": "${routerToken}", "headers": { "Cookie": "" } } },

    { "id": "create-plain-application",
      "request": { "method": "POST", "path": "/api/applications",
                   "body": { "code": "parity-plain-${run}", "name": "Parity Plain ${run}", "type": "APPLICATION" } },
      "expect": { "status": 201 },
      "capture": { "plainAppId": "/id" } },
    { "id": "provision-plain-service-account",
      "request": { "method": "POST", "path": "/api/applications/${plainAppId}/provision-service-account" },
      "expect": { "status": 201 },
      "capture": { "plainClientId": "/serviceAccount/oauthClient/clientId", "plainClientSecret": "/serviceAccount/oauthClient/clientSecret" } },
    { "id": "plain-token",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "client_credentials", "client_id": "${plainClientId}", "client_secret": "${plainClientSecret}" } },
      "expect": { "status": 200 },
      "capture": { "plainToken": "/access_token" } },
    { "id": "router-config-without-the-permission",
      "request": { "method": "GET", "path": "/api/dispatch/router-config", "auth": "${plainToken}", "headers": { "Cookie": "" } } },

    { "id": "router-config-unauthenticated",
      "request": { "method": "GET", "path": "/api/dispatch/router-config", "headers": { "Cookie": "" } } }
  ]
}
