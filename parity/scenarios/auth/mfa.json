{
  "name": "S2 auth: MFA — TOTP self-enrolment, the login gate, replay guard, trusted device, recovery code, method removal, admin reset",
  "why": "Everything a user with a second factor goes through. Pins: the enrol response (secret/uri shape; the QR is a PNG of a random secret and is ignored), confirm with a real RFC 6238 code, the status document, the login gate (status mfa_required + mfaToken), a wrong code's shape, a code refused when replayed (the replay guard — the harness computes the adjacent time step so confirm and verify use different codes, both within the ±1 window), rememberDevice honouring the domain policy (I-Q11), the trusted-device list/revoke, a recovery code as a factor, method removal, and the admin reset making the next login plain again.",
  "covers": ["resetPrincipalTwoFactor"],
  "steps": [
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 } },
    { "id": "status-before", "request": { "method": "GET", "path": "/auth/2fa/status" } },

    { "id": "totp-begin",
      "request": { "method": "POST", "path": "/auth/2fa/methods/totp/begin" },
      "expect": { "status": 200 },
      "capture": { "totpSecret": "/secret" },
      "ignore": [ { "pointer": "/qr", "reason": "a PNG of a per-side random secret; the uri it encodes is compared with the secret masked" } ] },
    { "id": "totp-confirm-wrong-code",
      "request": { "method": "POST", "path": "/auth/2fa/methods/totp/confirm", "body": { "code": "000000" } } },
    { "id": "totp-confirm",
      "request": { "method": "POST", "path": "/auth/2fa/methods/totp/confirm", "body": { "code": "${totp:totpSecret:-1}" } },
      "expect": { "status": 200 },
      "capture": { "rc0": "/recoveryCodes/0" },
      "ignore": [ { "pointer": "/recoveryCodes", "reason": "ten random codes per side; the first is captured and used below, the rest cannot be compared" } ] },
    { "id": "status-enrolled", "request": { "method": "GET", "path": "/auth/2fa/status" } },

    { "id": "logout", "request": { "method": "POST", "path": "/auth/logout" } },
    { "id": "login-gated",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 },
      "capture": { "mfaToken": "/mfaToken" } },
    { "id": "verify-wrong-code",
      "request": { "method": "POST", "path": "/auth/2fa/verify",
                   "body": { "mfaToken": "${mfaToken}", "method": "TOTP", "code": "000000", "rememberDevice": false } } },
    { "id": "verify-unknown-method",
      "request": { "method": "POST", "path": "/auth/2fa/verify",
                   "body": { "mfaToken": "${mfaToken}", "method": "SMS", "code": "000000", "rememberDevice": false } } },
    { "id": "verify",
      "request": { "method": "POST", "path": "/auth/2fa/verify",
                   "body": { "mfaToken": "${mfaToken}", "method": "TOTP", "code": "${totp:totpSecret:0}", "rememberDevice": true } },
      "expect": { "status": 200 } },
    { "id": "auth-me-after-verify", "request": { "method": "GET", "path": "/auth/me" } },
    { "id": "trusted-devices", "request": { "method": "GET", "path": "/auth/2fa/trusted-devices" } },

    { "id": "logout-2", "request": { "method": "POST", "path": "/auth/logout" } },
    { "id": "login-after-remember",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 },
      "capture": { "mfaToken2": "/mfaToken" } },
    { "id": "verify-replayed-code",
      "request": { "method": "POST", "path": "/auth/2fa/verify",
                   "body": { "mfaToken": "${mfaToken2}", "method": "TOTP", "code": "${totp:totpSecret:0}", "rememberDevice": false } } },
    { "id": "verify-with-recovery-code",
      "request": { "method": "POST", "path": "/auth/2fa/verify",
                   "body": { "mfaToken": "${mfaToken2}", "method": "RECOVERY_CODE", "code": "${rc0}", "rememberDevice": false } },
      "expect": { "status": 200 } },
    { "id": "status-after-recovery", "request": { "method": "GET", "path": "/auth/2fa/status" } },
    { "id": "regenerate-recovery-codes",
      "request": { "method": "POST", "path": "/auth/2fa/recovery-codes/regenerate" },
      "expect": { "status": 200 },
      "capture": { "rc1": "/recoveryCodes/0" },
      "ignore": [ { "pointer": "/recoveryCodes", "reason": "random per side; the first is captured" } ] },
    { "id": "old-recovery-code-dead",
      "request": { "method": "POST", "path": "/auth/logout" } },
    { "id": "login-gated-3",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 },
      "capture": { "mfaToken3": "/mfaToken" } },
    { "id": "verify-old-recovery-code",
      "request": { "method": "POST", "path": "/auth/2fa/verify",
                   "body": { "mfaToken": "${mfaToken3}", "method": "RECOVERY_CODE", "code": "${rc0}", "rememberDevice": false } } },
    { "id": "verify-new-recovery-code",
      "request": { "method": "POST", "path": "/auth/2fa/verify",
                   "body": { "mfaToken": "${mfaToken3}", "method": "RECOVERY_CODE", "code": "${rc1}", "rememberDevice": false } },
      "expect": { "status": 200 } },

    { "id": "remove-totp",
      "request": { "method": "DELETE", "path": "/auth/2fa/methods/TOTP" } },
    { "id": "remove-totp-again",
      "request": { "method": "DELETE", "path": "/auth/2fa/methods/TOTP" } },
    { "id": "status-after-removal", "request": { "method": "GET", "path": "/auth/2fa/status" } },

    { "id": "totp-begin-2",
      "request": { "method": "POST", "path": "/auth/2fa/methods/totp/begin" },
      "expect": { "status": 200 },
      "capture": { "totpSecret2": "/secret" },
      "ignore": [ { "pointer": "/qr", "reason": "PNG of a random secret" } ] },
    { "id": "totp-confirm-2",
      "request": { "method": "POST", "path": "/auth/2fa/methods/totp/confirm", "body": { "code": "${totp:totpSecret2:0}" } },
      "expect": { "status": 200 },
      "ignore": [ { "pointer": "/recoveryCodes", "reason": "random per side" } ] },
    { "id": "admin-reset-2fa",
      "request": { "method": "POST", "path": "/api/principals/${admin.id}/reset-2fa" } },
    { "id": "status-after-admin-reset", "request": { "method": "GET", "path": "/auth/2fa/status" } },
    { "id": "logout-3", "request": { "method": "POST", "path": "/auth/logout" } },
    { "id": "login-plain-again",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "${admin.email}", "password": "${admin.password}" } } }
  ]
}
