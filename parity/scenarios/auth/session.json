{
  "name": "S2 auth: session surface — check-domain, login, me, history, client selection, change-password, logout, backoff",
  "why": "The SPA's whole sign-in path. Pins: the login envelope (status/principalId/roles/permissions/clientId) and the cookie attributes; the wrong-password shape; /auth/me and login-history bodies; client selection minting a full-authority token that /api/me accepts as a Bearer; change-password refusing a wrong current password and accepting the new one on the next login; logout clearing the cookie so /auth/me is refused; the backoff sequence on a throwaway identifier — the attempt at which 429 begins, its envelope and Retry-After presence (C-Q rulings on backoff numbers).",
  "covers": ["createPrincipal", "assignPrincipalRoles"],
  "steps": [
    { "id": "check-domain",
      "request": { "method": "POST", "path": "/auth/check-domain", "body": { "email": "${admin.email}" } } },
    { "id": "check-domain-legacy",
      "request": { "method": "GET", "path": "/auth/check-domain", "query": { "email": "${admin.email}" } } },
    { "id": "check-domain-unknown",
      "request": { "method": "POST", "path": "/auth/check-domain", "body": { "email": "nobody-${run}@unmapped-example.org" } } },

    { "id": "login-wrong-password",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "not-the-password-${run}" } } },
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 },
      "capture": { "sess": "cookie:fc_session" } },

    { "id": "create-passwordless-check-domain-target",
      "why": "app-managed-invitations §2: a principal created passwordless (no password given) is awaitingPasswordSetup and check-domain must flag it",
      "request": { "method": "POST", "path": "/api/principals",
                   "body": { "email": "parity-passwordless-${run}@example.test", "name": "Parity Passwordless CheckDomain",
                             "scope": "CLIENT", "clientId": "${client.id}" } },
      "expect": { "status": 201 } },

    { "id": "check-domain-passwordless-awaiting-setup",
      "why": "app-managed-invitations §2: an internal user with no password set answers passwordSetupRequired:true, never false, never alongside authMethod:external",
      "request": { "method": "POST", "path": "/auth/check-domain",
                   "body": { "email": "parity-passwordless-${run}@example.test" } } },

    { "id": "create-with-password-check-domain-target",
      "why": "the negative case: a principal created with a password is never awaitingPasswordSetup",
      "request": { "method": "POST", "path": "/api/principals",
                   "body": { "email": "parity-haspassword-${run}@example.test", "name": "Parity HasPassword CheckDomain",
                             "scope": "CLIENT", "clientId": "${client.id}", "password": "Correct-Harness-Battery-4471" } },
      "expect": { "status": 201 } },

    { "id": "check-domain-with-password-no-flag",
      "why": "app-managed-invitations §2: passwordSetupRequired is absent (never false) once the user has a password",
      "request": { "method": "POST", "path": "/auth/check-domain",
                   "body": { "email": "parity-haspassword-${run}@example.test" } } },

    { "id": "password-setup-request-eligible",
      "why": "app-managed-invitations §3: the fixed silent-200 body for an eligible (passwordless internal) address",
      "request": { "method": "POST", "path": "/auth/password-setup/request",
                   "body": { "email": "parity-passwordless-${run}@example.test" } },
      "expect": { "status": 200 } },

    { "id": "password-setup-request-ineligible",
      "why": "app-managed-invitations §3: the same fixed 200 for a user who already has a password — no account-existence or eligibility signal leaks",
      "request": { "method": "POST", "path": "/auth/password-setup/request",
                   "body": { "email": "parity-haspassword-${run}@example.test" } },
      "expect": { "status": 200 } },

    { "id": "password-setup-request-bad-body",
      "why": "app-managed-invitations §3 table row 1: a non-object JSON body (the scenario format cannot send syntactically malformed JSON, so this exercises the same body()==null branch PasswordResetApi#passwordSetupRequest guards) is 400 INVALID_BODY on both sides",
      "request": { "method": "POST", "path": "/auth/password-setup/request", "body": "not-an-object" } },

    { "id": "auth-me", "request": { "method": "GET", "path": "/auth/me" } },
    { "id": "api-me", "request": { "method": "GET", "path": "/api/me" } },
    { "id": "login-history",
      "request": { "method": "GET", "path": "/auth/login-history" },
      "ignore": [ { "pointer": "/attempts/*/userAgent", "reason": "the harness's own User-Agent string names the JDK version on both sides identically today, but it is the client's, not the server's" } ] },

    { "id": "client-accessible", "request": { "method": "GET", "path": "/auth/client/accessible" } },
    { "id": "client-current", "request": { "method": "GET", "path": "/auth/client/current" } },
    { "id": "client-switch",
      "request": { "method": "POST", "path": "/auth/client/switch", "body": { "clientId": "${client.id}" } },
      "expect": { "status": 200 },
      "capture": { "switchToken": "/token" } },
    { "id": "client-switch-unknown",
      "request": { "method": "POST", "path": "/auth/client/switch", "body": { "clientId": "cli_000000000000" } } },
    { "id": "api-me-with-switched-token",
      "request": { "method": "GET", "path": "/api/me", "auth": "${switchToken}" } },

    { "id": "change-password-wrong-current",
      "request": { "method": "POST", "path": "/auth/change-password",
                   "body": { "currentPassword": "not-the-password-${run}", "newPassword": "Rotated-Harness-Passphrase-${run}" } } },
    { "id": "change-password-weak",
      "request": { "method": "POST", "path": "/auth/change-password",
                   "body": { "currentPassword": "${admin.password}", "newPassword": "short" } } },
    { "id": "change-password",
      "request": { "method": "POST", "path": "/auth/change-password",
                   "body": { "currentPassword": "${admin.password}", "newPassword": "Rotated-Harness-Passphrase-${run}" } },
      "expect": { "status": 200 } },

    { "id": "logout", "request": { "method": "POST", "path": "/auth/logout" } },
    { "id": "auth-me-after-logout", "request": { "method": "GET", "path": "/auth/me" } },

    { "id": "login-old-password",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "${admin.password}" } } },
    { "id": "login-new-password",
      "request": { "method": "POST", "path": "/auth/login",
                   "body": { "email": "${admin.email}", "password": "Rotated-Harness-Passphrase-${run}" } },
      "expect": { "status": 200 } },
    { "id": "change-password-back",
      "request": { "method": "POST", "path": "/auth/change-password",
                   "body": { "currentPassword": "Rotated-Harness-Passphrase-${run}", "newPassword": "${admin.password}" } },
      "expect": { "status": 200 } },

    { "id": "create-backoff-victim",
      "request": { "method": "POST", "path": "/api/principals",
                   "body": { "email": "parity-backoff-${run}@example.com", "name": "Parity Backoff Victim",
                             "scope": "CLIENT", "clientId": "${client.id}", "password": "Correct-Harness-Battery-7731" } },
      "expect": { "status": 201 },
      "capture": { "victimId": "/id" } },
    { "id": "assign-victim-role",
      "request": { "method": "PUT", "path": "/api/principals/${victimId}/roles", "body": { "roles": ["platform:messaging-admin"] } },
      "expect": { "status": 200 } },
    { "id": "backoff-1", "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "wrong-1" } } },
    { "id": "backoff-2", "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "wrong-2" } } },
    { "id": "backoff-3", "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "wrong-3" } } },
    { "id": "backoff-4", "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "wrong-4" } } },
    { "id": "backoff-5", "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "wrong-5" } } },
    { "id": "backoff-6", "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "wrong-6" } } },
    { "id": "backoff-7", "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "wrong-7" } } },
    { "id": "backoff-right-password-while-backed-off",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "parity-backoff-${run}@example.com", "password": "Correct-Harness-Battery-7731" } } }
  ]
}
