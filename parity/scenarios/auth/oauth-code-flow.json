{
  "name": "S2 auth: OAuth authorization code + PKCE, refresh rotation, introspection, userinfo, revoke, client credentials, discovery",
  "why": "The provider surface a third-party client sees. Pins: the authorize redirect (307, code and state in Location; the 400 shapes for a bad redirect_uri and an unknown client); the token envelope for the code exchange (expires_in = configured TTL, id_token present with openid, no-store headers); the decoded claim sets of access, refresh-minted and id tokens (rule 4: aud/azp/tier/auth_time shapes); a replayed code refused; refresh rotation and the family revocation on reuse (C-Q rulings §7.4); introspection active/inactive shapes; userinfo through confineToClient; revoke as best-effort 200; client_credentials; /auth/refresh over the same family; discovery and JWKS documents.",
  "covers": ["createOAuthClient", "createApplication", "provisionApplicationServiceAccount"],
  "steps": [
    { "id": "login",
      "request": { "method": "POST", "path": "/auth/login", "body": { "email": "${admin.email}", "password": "${admin.password}" } },
      "expect": { "status": 200 } },

    { "id": "create-client",
      "request": { "method": "POST", "path": "/api/oauth-clients",
                   "body": { "clientName": "Parity Web ${run}", "clientType": "CONFIDENTIAL",
                             "redirectUris": ["https://parity.example/cb"],
                             "grantTypes": ["authorization_code", "refresh_token", "client_credentials"],
                             "defaultScopes": ["openid", "profile", "email"], "pkceRequired": true } },
      "expect": { "status": 201 },
      "capture": { "clientRowId": "/client/id", "clientId": "/client/clientId", "clientSecret": "/clientSecret" } },

    { "id": "authorize",
      "request": { "method": "GET", "path": "/oauth/authorize",
                   "query": { "response_type": "code", "client_id": "${clientId}", "redirect_uri": "https://parity.example/cb",
                              "scope": "openid profile email offline_access", "state": "st-${run}", "nonce": "n-${run}",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "code": "location-param:code" } },
    { "id": "authorize-bad-redirect",
      "request": { "method": "GET", "path": "/oauth/authorize",
                   "query": { "response_type": "code", "client_id": "${clientId}", "redirect_uri": "https://evil.example/cb", "state": "s" } } },
    { "id": "authorize-unknown-client",
      "request": { "method": "GET", "path": "/oauth/authorize",
                   "query": { "response_type": "code", "client_id": "nope-${run}", "redirect_uri": "https://parity.example/cb", "state": "s" } } },
    { "id": "authorize-unsupported-response-type",
      "request": { "method": "GET", "path": "/oauth/authorize",
                   "query": { "response_type": "token", "client_id": "${clientId}", "redirect_uri": "https://parity.example/cb", "state": "s",
                              "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } } },

    { "id": "token",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "authorization_code", "code": "${code}", "redirect_uri": "https://parity.example/cb",
                             "client_id": "${clientId}", "client_secret": "${clientSecret}", "code_verifier": "${pkce.verifier}" } },
      "expect": { "status": 200 },
      "capture": { "access1": "/access_token", "refresh1": "/refresh_token", "idToken": "/id_token" } },
    { "id": "token-replayed-code",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "authorization_code", "code": "${code}", "redirect_uri": "https://parity.example/cb",
                             "client_id": "${clientId}", "client_secret": "${clientSecret}", "code_verifier": "${pkce.verifier}" } } },
    { "id": "token-wrong-secret",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "client_credentials", "client_id": "${clientId}", "client_secret": "not-it-${run}" } } },

    { "id": "introspect-active",
      "request": { "method": "POST", "path": "/oauth/introspect",
                   "form": { "token": "${access1}", "client_id": "${clientId}", "client_secret": "${clientSecret}" } } },
    { "id": "introspect-garbage",
      "request": { "method": "POST", "path": "/oauth/introspect",
                   "form": { "token": "not-a-token-${run}", "client_id": "${clientId}", "client_secret": "${clientSecret}" } } },
    { "id": "userinfo",
      "request": { "method": "GET", "path": "/oauth/userinfo", "auth": "${access1}" } },
    { "id": "userinfo-no-bearer",
      "request": { "method": "POST", "path": "/oauth/userinfo", "headers": { "Cookie": "" } } },

    { "id": "refresh",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "refresh_token", "refresh_token": "${refresh1}", "client_id": "${clientId}", "client_secret": "${clientSecret}" } },
      "expect": { "status": 200 },
      "capture": { "access2": "/access_token", "refresh2": "/refresh_token" } },
    { "id": "refresh-reuse-rotated-token",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "refresh_token", "refresh_token": "${refresh1}", "client_id": "${clientId}", "client_secret": "${clientSecret}" } } },
    { "id": "refresh-after-family-revoked",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "refresh_token", "refresh_token": "${refresh2}", "client_id": "${clientId}", "client_secret": "${clientSecret}" } } },

    { "id": "client-credentials-unbound-client",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "client_credentials", "client_id": "${clientId}", "client_secret": "${clientSecret}" } } },
    { "id": "create-application",
      "request": { "method": "POST", "path": "/api/applications",
                   "body": { "code": "parity-cc-${run}", "name": "Parity CC ${run}", "type": "APPLICATION" } },
      "expect": { "status": 201 },
      "capture": { "ccAppId": "/id" } },
    { "id": "provision-service-account",
      "request": { "method": "POST", "path": "/api/applications/${ccAppId}/provision-service-account" },
      "expect": { "status": 201 },
      "capture": { "saClientId": "/serviceAccount/oauthClient/clientId", "saClientSecret": "/serviceAccount/oauthClient/clientSecret",
                   "saPrincipalId": "/serviceAccount/principalId", "saClientRowId": "/serviceAccount/oauthClient/id" } },
    { "id": "client-credentials",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "client_credentials", "client_id": "${saClientId}", "client_secret": "${saClientSecret}" } },
      "expect": { "status": 200 },
      "capture": { "ccToken": "/access_token" } },
    { "id": "api-me-with-client-credentials-token",
      "request": { "method": "GET", "path": "/api/me", "auth": "${ccToken}", "headers": { "Cookie": "" } } },
    { "id": "introspect-client-credentials-token",
      "request": { "method": "POST", "path": "/oauth/introspect", "auth": "${ccToken}", "form": { "token": "${ccToken}" } } },

    { "id": "authorize-again",
      "request": { "method": "GET", "path": "/oauth/authorize",
                   "query": { "response_type": "code", "client_id": "${clientId}", "redirect_uri": "https://parity.example/cb",
                              "scope": "openid offline_access", "state": "st2-${run}", "code_challenge": "${pkce.challenge}", "code_challenge_method": "S256" } },
      "expect": { "status": 307 },
      "capture": { "code2": "location-param:code" } },
    { "id": "token-again",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "authorization_code", "code": "${code2}", "redirect_uri": "https://parity.example/cb",
                             "client_id": "${clientId}", "client_secret": "${clientSecret}", "code_verifier": "${pkce.verifier}" } },
      "expect": { "status": 200 },
      "capture": { "refresh3": "/refresh_token" } },
    { "id": "auth-refresh-refuses-a-client-bound-token",
      "request": { "method": "POST", "path": "/auth/refresh", "body": { "refreshToken": "${refresh3}" } } },
    { "id": "revoke",
      "request": { "method": "POST", "path": "/oauth/revoke",
                   "form": { "token": "${refresh3}", "client_id": "${clientId}", "client_secret": "${clientSecret}" } } },
    { "id": "refresh-revoked",
      "request": { "method": "POST", "path": "/oauth/token",
                   "form": { "grant_type": "refresh_token", "refresh_token": "${refresh3}", "client_id": "${clientId}", "client_secret": "${clientSecret}" } } },

    { "id": "discovery", "request": { "method": "GET", "path": "/.well-known/openid-configuration" } },
    { "id": "jwks", "request": { "method": "GET", "path": "/.well-known/jwks.json" } }
  ]
}
