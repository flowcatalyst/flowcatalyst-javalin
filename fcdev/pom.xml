<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.flowcatalyst</groupId>
    <artifactId>flowcatalyst-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>flowcatalyst-fcdev</artifactId>
  <packaging>jar</packaging>

  <name>FlowCatalyst fcdev</name>
  <description>
    fcdev: the developer monolith — fc-server plus an embedded PostgreSQL and dev defaults
    (port of flowcatalyst-go/cmd/fcdev). Built as a single executable jar.
  </description>

  <properties>
    <native.optimization>-Os</native.optimization>
    <!-- Stamped into fcdev-build.properties; a release build passes -Dfcdev.vcs.revision=<sha>. -->
    <fcdev.vcs.revision></fcdev.vcs.revision>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-server</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- `docs/spec/function-developer-surface.md` §1 (slice E1): fcdev hosts
         a function host beside the platform — `FnHostLauncher`'s JVM branch
         runs `io.flowcatalyst.fnhost.FnHost` in this same process. -->
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-function-host</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>

    <!-- fcdev outbox create-table (db-type mysql): mysql-connector-j is a
         plain JDBC driver, loaded via DriverManager (no ORM/DSL layer needed
         for one CREATE TABLE statement); see OutboxCommand.CreateTable. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>

    <!-- Embedded PostgreSQL (zonky). fcdev does NOT bundle the per-platform
         embedded-postgres-binaries-* archives (that's the server module's tests,
         see server/pom.xml) — io.flowcatalyst.fcdev.MavenCentralPgBinaryResolver
         downloads the one matching the host OS/arch from Maven Central on first
         run and caches it under DevPaths#embeddedPgCacheDir(), the same way the
         Go fcdev does. The start flag embedded-db-binary (env FC_EMBEDDED_DB_BINARY)
         overrides with a local .txz for offline/air-gapped use.

         io.zonky.test:embedded-postgres itself declares four of the binary
         archives (windows-amd64, darwin-amd64, linux-amd64, linux-amd64-alpine)
         as plain non-optional runtime dependencies in its own POM — excluded
         here, or they come along transitively regardless of what fcdev
         declares directly. -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <exclusions>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Logging: configured programmatically via io.flowcatalyst.server.Logging (no logback.xml). -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- E1's in-process acceptance test builds real fixture function jars via
         `io.flowcatalyst.fnhost.load.FixtureJars` (function-host's own test
         support) rather than a second copy — function-host/pom.xml now builds
         a test-jar the same way server/pom.xml does. CLAUDE.md build hygiene:
         never `mvn install` from a worktree — the reactor resolves this from
         function-host's own target/test-classes when built with `-pl fcdev -am`. -->
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-function-host</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>fcdev-build.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>fcdev-build.properties</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <!--
        The executable fat jar — the GitHub-Releases fallback for developers without JBang:

          java -jar fcdev/target/flowcatalyst-fcdev-0.0.1-SNAPSHOT.jar [start|stop|fresh|…]

        The shaded jar REPLACES the thin jar as the module's main artifact, and the
        dependency-reduced POM is what gets installed, so `jbang fcdev.java` (which
        depends on io.flowcatalyst:flowcatalyst-fcdev) resolves exactly one jar.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <!-- netty ships its own native-image reflection metadata inside each jar, and
                         the GraalVM reachability-metadata repository OVERRIDES it (native-maven-plugin
                         passes an exclude-config for every netty jar). Shaded into this jar the same
                         files ride along under a path the exclusion does not cover, so the native build
                         read netty's blanket handler registration, reached the OpenSSL engine through a
                         constructor signature, and failed initialising tcnative's JNI interface at build
                         time. The individual netty jars are on the native classpath anyway. -->
                    <exclude>META-INF/native-image/io.netty/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.flowcatalyst.fcdev.FcDev</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                    <Implementation-Title>fcdev</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      GraalVM native image for the developer binary — same template as
      server/pom.xml's `native` profile (read that one first). fcdev embeds
      the whole server, so it needs everything that profile needs PLUS its
      own reflection (picocli's @Command classes) and reachability metadata
      (zonky's embedded-postgres, which the server module never ships to
      production — see the dependency comment above):

        mise install java@oracle-graalvm-25.0.4.1
        JAVA_HOME=$(mise where java@oracle-graalvm-25.0.4.1) mvn -q -DskipTests -pl fcdev -am -Pnative package
        fcdev/target/fcdev
    -->
    <profile>
      <id>native</id>
      <dependencies>
        <!-- Annotation processor only (provided scope, never shipped): generates
             picocli's own reflect-config.json / native-image.properties for every
             @Command class at compile time (-Aproject=fcdev below). Do not hand-write
             picocli's reflection entries. -->
        <dependency>
          <groupId>info.picocli</groupId>
          <artifactId>picocli-codegen</artifactId>
          <version>${picocli.version}</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <executions>
              <!-- Scoped to main sources only (the implicit "default-compile" execution):
                   test sources have no @Command classes, and picocli-codegen does not
                   claim -Aproject, so javac's "option not recognized by any processor"
                   warning becomes a hard error under this repo's failOnWarning — applying
                   the processor to default-testCompile too failed the build on exactly
                   that warning. -->
              <execution>
                <id>default-compile</id>
                <configuration>
                  <compilerArgs>
                    <arg>-Xlint:all,-processing,-serial,-preview,-this-escape</arg>
                    <arg>-parameters</arg>
                    <arg>--enable-preview</arg>
                    <arg>-Aproject=fcdev</arg>
                  </compilerArgs>
                  <!-- Explicit path rather than relying on the provided-scope dependency
                       landing on javac's implicit processor path: some compiler-plugin
                       versions only run annotation processing for paths named here. -->
                  <annotationProcessorPaths>
                    <path>
                      <groupId>info.picocli</groupId>
                      <artifactId>picocli-codegen</artifactId>
                      <version>${picocli.version}</version>
                    </path>
                  </annotationProcessorPaths>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- Reflection config for our own classes: records, enums, Jackson-annotated
               DTOs and jOOQ record types only (io.flowcatalyst.tools.NativeReflectConfig,
               server test scope — additionalClasspathElements puts it on the classpath
               here since fcdev has no dependency on server's test-jar). Scans fcdev's own
               classes plus the sibling modules the fcdev binary actually embeds
               (server, usecase — fcdev has no dependency on the flowcatalyst-sdk client
               module, so unlike the brief's literal list that one is not scanned; see
               docs/fcdev.md "native binary" // SPEC?). -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>native-reflect-config</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>io.flowcatalyst.tools.NativeReflectConfig</mainClass>
                  <classpathScope>test</classpathScope>
                  <additionalClasspathElements>
                    <additionalClasspathElement>${project.basedir}/../server/target/test-classes</additionalClasspathElement>
                  </additionalClasspathElements>
                  <arguments>
                    <argument>${project.build.directory}/native-reflect-config.json</argument>
                    <argument>${project.build.outputDirectory}</argument>
                    <argument>${project.basedir}/../server/target/classes</argument>
                    <argument>${project.basedir}/../usecase/target/classes</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>1.1.12</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>fcdev</imageName>
              <mainClass>io.flowcatalyst.fcdev.FcDev</mainClass>
              <metadataRepository>
                <enabled>true</enabled>
              </metadataRepository>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <!-- Without this java.net.URL cannot parse an http(s) URL in the
                     image: yubico's RelyingParty does `new URL(origin)` and falls
                     back to exact string matching for WebAuthn origins. Outbound
                     HTTP is java.net.http.HttpClient and unaffected. -->
                <buildArg>--enable-url-protocols=http,https</buildArg>
                <buildArg>--enable-preview</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <!-- Same discipline as server/pom.xml: name exactly our runtime resources,
                     not a blanket `io/.*` that would sweep every .class file on the
                     classpath into the image heap as bytes. fcdev adds its own two
                     classpath-root resources (VERSION, fcdev-build.properties) to the
                     server's list; everything else here is the embedded server. -->
                <buildArg>-H:IncludeResources=db/.*|frontend/.*|openapi/.*|docs/.*|router/.*|io/flowcatalyst/platform/principal/common_passwords\.txt|VERSION|fcdev-build\.properties</buildArg>
                <!-- -Os by default (binary-size ruling for the developer binary); pass
                     -Dnative.optimization=-O2 for the server-speed build (see server/pom.xml). -->
                <buildArg>${native.optimization}</buildArg>
                <buildArg>-H:ReflectionConfigurationFiles=${project.build.directory}/native-reflect-config.json</buildArg>
                <!-- Both directories: server/native-config covers the third-party reachability
                     every server binary needs (jOOQ, Jackson, the Postgres driver, Vert.x, and
                     Jetty for MCP's own listener);
                     fcdev/native-config adds what only the dev monolith uses in production
                     (zonky's embedded-postgres — server never ships that to production, see
                     the dependency comment above; mysql-connector-j for `fcdev outbox`). -->
                <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/../server/native-config,${project.basedir}/native-config</buildArg>
                <!-- No jar manifest in a native image; Version reads this property instead. -->
                <buildArg>-Dfc.version=${project.version}</buildArg>
                <buildArg>--initialize-at-build-time=io.flowcatalyst.server.Version</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
