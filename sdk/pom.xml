<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.flowcatalyst</groupId>
    <artifactId>flowcatalyst-parent</artifactId>

    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <properties>
    <!-- openapi-generator output uses a deprecated Jackson API. We neither
         write it nor can fix it, so this module alone does not treat
         warnings as errors. Every other module does. -->
    <maven.compiler.failOnWarning>false</maven.compiler.failOnWarning>
  </properties>

  <artifactId>flowcatalyst-sdk</artifactId>
  <packaging>jar</packaging>

  <name>FlowCatalyst Java SDK</name>
  <description>Plain-Java client SDK for the FlowCatalyst platform</description>

  <dependencies>
    <!-- In-repo: TSID primitives + the use-case envelope shared with the platform. -->
    <dependency>
      <groupId>io.flowcatalyst</groupId>
      <artifactId>flowcatalyst-usecase</artifactId>
    </dependency>

    <!-- Hand-written SDK code + the usecase.OutboxSink interop point (its
         ObjectMapper constructor param) are Jackson 3. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The generated OpenAPI client (ApiClient, model classes) is hardcoded
         to Jackson 2 by the openapi-generator-maven-plugin's own templates —
         not something this module's own code controls. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <!-- compile-only: generated models carry JSR-305 @Nullable/@Nonnull and @Generated -->
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Outbox JDBC driver tests: H2 in-memory always; real PG when FC_JAVA_SDK_TEST_PG_URL is set -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.14.0</version>
        <executions>
          <execution>
            <id>generate-models</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/openapi/openapi.json</inputSpec>
              <generatorName>java</generatorName>
              <library>native</library>
              <modelPackage>io.flowcatalyst.sdk.generated.model</modelPackage>
              <generateApis>false</generateApis>
              <generateModelDocumentation>false</generateModelDocumentation>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateSupportingFiles>true</generateSupportingFiles>
              <supportingFilesToGenerate>ApiClient.java,ApiException.java,ApiResponse.java,Pair.java,RFC3339DateFormat.java,RFC3339JavaTimeModule.java,RFC3339InstantDeserializer.java</supportingFilesToGenerate>
              <configOptions>
                <dateLibrary>java8</dateLibrary>
                <openApiNullable>false</openApiNullable>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <containerDefaultToNull>true</containerDefaultToNull>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
