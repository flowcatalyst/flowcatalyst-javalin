+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest("GET", "/oauth/authorize?response_type=code&client_id=c&redirect_uri=https://app/cb&state=xyz", nil)
+	s.Authorize(rec, req)
+
+	if rec.Code != 307 {
+		t.Fatalf("status = %d, want 307", rec.Code)
+	}
+	if loc := rec.Header().Get("Location"); !strings.Contains(loc, "error=unauthorized_client") {
+		t.Fatalf("Location = %q, want error=unauthorized_client", loc)
+	}
